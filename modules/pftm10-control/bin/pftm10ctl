#!/system/bin/sh

STATE=/data/adb/pftm10-control
LOG="$STATE/boot.log"
BATTERY_RESTRICT_APK=/my_bigball/plugin/BatteryRestrictPlugin/BatteryRestrictPlugin.apk
BATTERY_RESTRICT_MASK="$STATE/battery-restrict-disabled.apk"
CHARGE_3A_SENTINEL="$STATE/charge-3a.enabled"

usage() {
    echo "usage: pftm10ctl {status|caps|health|preload|kprobe|kprobe-ctl|kpm-info|kpm-list|battery-restrict|charge-3a|root|bootlog|kpm|enforcing|permissive}"
}

if [ "$(id -u)" != "0" ]; then
    echo "pftm10ctl requires root" >&2
    exit 1
fi

preload_status() {
    preload_mount=$(mount | grep " on /mnt/vendor/my_preload " | head -n 1)
    if [ -z "$preload_mount" ]; then
        echo "preload_mount=missing"
        echo "preload_del_app_entries=unknown"
        echo "preload_build_prop=unknown"
        return 1
    fi

    entries=$(find /mnt/vendor/my_preload/del-app -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')
    build_prop=no
    if [ -f /mnt/vendor/my_preload/build.prop ]; then
        build_prop=yes
    fi

    echo "preload_mount=present"
    echo "preload_del_app_entries=$entries"
    echo "preload_build_prop=$build_prop"

    [ "$entries" = "0" ] && [ "$build_prop" = "yes" ]
}

kprobe_status() {
    kprobe=/data/adb/ap/kpm/pftm10-kprobe/pftm10-kprobe.kpm
    expected=c962a36c65dc8fc560d7b08f19777ad6b00784cc3cea843e836731d5b1433594

    if [ ! -f "$kprobe" ]; then
        echo "kprobe_file=missing"
        echo "kprobe_load=unknown"
        return 1
    fi

    actual=$(sha256sum "$kprobe" 2>/dev/null | cut -d ' ' -f 1)
    if [ "$actual" = "$expected" ]; then
        echo "kprobe_file=match"
    else
        echo "kprobe_file=mismatch"
        echo "kprobe_sha256=$actual"
        echo "kprobe_load=unknown"
        return 1
    fi

    if kpm_info_status; then
        echo "kprobe_load=ok"
        kprobe_version=$(printf '%s\n' "$KPM_INFO" | sed -n 's/^version=//p' | head -n 1)
        kprobe_event=$(printf '%s\n' "$KPM_INFO" | sed -n 's/^load_event=//p' | head -n 1)
        echo "kprobe_version=${kprobe_version:-unknown}"
        echo "kprobe_event=${kprobe_event:-unknown}"
        echo "kprobe_source=manager-supercmd"
        kprobe_control_status || return 1
    else
        echo "kprobe_load=unknown"
        return 1
    fi
}

manager_uid() {
    for path in /data/user/0/me.bmax.apatch /data/data/me.bmax.apatch; do
        if [ -d "$path" ]; then
            stat -c %u "$path" 2>/dev/null
            return $?
        fi
    done
    return 1
}

kpm_info_status() {
    KPM_MANAGER_UID=$(manager_uid)
    if [ -z "$KPM_MANAGER_UID" ]; then
        echo "kprobe_manager=missing"
        KPM_INFO=
        return 1
    fi

    if ! KPM_INFO=$(su "$KPM_MANAGER_UID" -c '/system/bin/truncate su module info pftm10-kprobe' 2>/dev/null); then
        echo "kprobe_manager_uid=$KPM_MANAGER_UID"
        echo "kprobe_info=unavailable"
        KPM_INFO=
        return 1
    fi

    if ! printf '%s\n' "$KPM_INFO" | grep -q '^name=pftm10-kprobe$'; then
        echo "kprobe_manager_uid=$KPM_MANAGER_UID"
        echo "kprobe_info=invalid"
        KPM_INFO=
        return 1
    fi

    echo "kprobe_manager_uid=$KPM_MANAGER_UID"
    return 0
}

kprobe_control_status() {
    helper="${0%/*}/pftm10-kpmctl"
    if [ ! -x "$helper" ]; then
        echo "kprobe_control=missing"
        return 1
    fi

    if ! kprobe_control_output=$("$helper" info 2>/dev/null); then
        echo "kprobe_control=failed"
        return 1
    fi

    if printf '%s\n' "$kprobe_control_output" | grep -q 'kpver=d09'; then
        echo "kprobe_control=ok"
        echo "kprobe_control_source=manager-supercall"
        return 0
    fi

    echo "kprobe_control=invalid"
    return 1
}

kpm_list_status() {
    manager=$(manager_uid)
    if [ -z "$manager" ]; then
        echo "kpm_manager=missing"
        return 1
    fi
    su "$manager" -c '/system/bin/truncate su module list'
}

battery_restrict_is_mounted() {
    mount | grep -F " on $BATTERY_RESTRICT_APK " >/dev/null 2>&1
}

battery_restrict_status() {
    if [ ! -f "$BATTERY_RESTRICT_APK" ]; then
        echo "battery_restrict=missing"
        return 1
    fi

    size=$(stat -c %s "$BATTERY_RESTRICT_APK" 2>/dev/null)
    if battery_restrict_is_mounted && [ "$size" = "0" ]; then
        echo "battery_restrict=masked"
        echo "battery_restrict_mount=bind"
        echo "battery_restrict_size=0"
        return 0
    fi

    echo "battery_restrict=active"
    echo "battery_restrict_mount=none"
    echo "battery_restrict_size=${size:-unknown}"
    return 0
}

battery_restrict_mask() {
    if [ ! -f "$BATTERY_RESTRICT_APK" ]; then
        echo "battery_restrict=mask_failed"
        echo "battery_restrict_reason=plugin_missing"
        return 1
    fi

    if battery_restrict_is_mounted; then
        battery_restrict_status
        return $?
    fi

    mkdir -p "$STATE"
    : > "$BATTERY_RESTRICT_MASK"
    chmod 0444 "$BATTERY_RESTRICT_MASK"

    if ! mount --bind "$BATTERY_RESTRICT_MASK" "$BATTERY_RESTRICT_APK"; then
        echo "battery_restrict=mask_failed"
        echo "battery_restrict_reason=bind_failed"
        return 1
    fi

    battery_restrict_status
}

battery_restrict_restore() {
    if [ ! -f "$BATTERY_RESTRICT_APK" ]; then
        echo "battery_restrict=missing"
        return 1
    fi

    if battery_restrict_is_mounted; then
        if ! umount "$BATTERY_RESTRICT_APK"; then
            echo "battery_restrict=restore_failed"
            echo "battery_restrict_reason=umount_failed"
            return 1
        fi
    fi

    battery_restrict_status
}

charge_3a_status() {
    if [ -f "$CHARGE_3A_SENTINEL" ]; then
        echo "charge_3a=armed"
    else
        echo "charge_3a=disabled"
    fi
    watchdog=running
    if [ -f "$STATE/charge-3a.pid" ]; then
        pid=$(cat "$STATE/charge-3a.pid" 2>/dev/null)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || watchdog=stale
    else
        watchdog=missing
    fi
    echo "charge_3a_watchdog=$watchdog"
    "${0%/*}/pftm10-kpmctl" pd-contract 2>&1
    if [ -r /sys/devices/virtual/oplus_chg/battery/input_current_settled ]; then
        echo "input_current_settled=$(cat /sys/devices/virtual/oplus_chg/battery/input_current_settled)"
    fi
}

charge_3a_apply() {
    output=$("${0%/*}/pftm10-kpmctl" charger-3a 2>&1)
    rc=$?
    echo "$output"
    [ "$rc" -eq 0 ] || return "$rc"
    case "$output" in
        *charger_3a_applied=1*) return 0 ;;
    esac
    return 1
}

charge_3a_enable() {
    mkdir -p "$STATE"
    : > "$CHARGE_3A_SENTINEL"
    chmod 0600 "$CHARGE_3A_SENTINEL"
    charge_3a_apply
    watchdog_running=no
    if [ -f "$STATE/charge-3a.pid" ]; then
        pid=$(cat "$STATE/charge-3a.pid" 2>/dev/null)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && watchdog_running=yes
    fi
    if [ "$watchdog_running" = "no" ]; then
        setsid /system/bin/sh "${0%/*}/charge-3a-watchdog.sh" \
            >/dev/null 2>&1 &
        echo "$!" > "$STATE/charge-3a.pid"
    fi
}

charge_3a_disable() {
    if [ -f "$STATE/charge-3a.pid" ]; then
        pid=$(cat "$STATE/charge-3a.pid" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
        fi
        rm -f "$STATE/charge-3a.pid"
    fi
    rm -f "$CHARGE_3A_SENTINEL"
    sleep 1
    "${0%/*}/pftm10-kpmctl" charger-restore 2>&1
    charge_3a_status
}

caps_status() {
    rc=0
    echo "root_uid=$(id -u)"
    echo "context=$(cat /proc/self/attr/current 2>/dev/null)"
    echo "boot_completed=$(getprop sys.boot_completed)"
    echo "locked=$(getprop ro.boot.flash.locked)"
    echo "verified=$(getprop ro.boot.verifiedbootstate)"
    echo "selinux=$(getenforce 2>&1)"
    echo "control_prop=$(getprop ro.pftm10.control)"

    [ "$(id -u)" = "0" ] || rc=1
    [ "$(getprop sys.boot_completed)" = "1" ] || rc=1
    [ "$(getprop ro.pftm10.control)" = "active" ] || rc=1
    preload_status || rc=1
    kprobe_status || rc=1
    battery_restrict_status || true

    if [ "$rc" -eq 0 ]; then
        echo "capabilities=ok"
    else
        echo "capabilities=failed"
    fi
    return "$rc"
}

health_status() {
    rc=0
    echo "uid=$(id -u)"
    echo "context=$(cat /proc/self/attr/current 2>/dev/null)"
    echo "build=$(getprop ro.build.display.id)"
    echo "boot_completed=$(getprop sys.boot_completed)"
    echo "locked=$(getprop ro.boot.flash.locked)"
    echo "verified=$(getprop ro.boot.verifiedbootstate)"
    echo "selinux=$(getenforce 2>&1)"
    echo "control_prop=$(getprop ro.pftm10.control)"
    echo "apd=$(/data/adb/apd -V 2>&1)"
    echo "kernel=$(uname -r)"

    if [ "$(id -u)" != "0" ]; then
        rc=1
    fi
    if [ "$(getprop sys.boot_completed)" != "1" ]; then
        rc=1
    fi
    if [ "$(getprop ro.pftm10.control)" != "active" ]; then
        rc=1
    fi
    preload_status || rc=1
    kprobe_status || rc=1

    if [ "$rc" -eq 0 ]; then
        echo "health=ok"
    else
        echo "health=failed"
    fi
    return "$rc"
}

case "$1" in
    status)
        echo "build=$(getprop ro.build.display.id)"
        echo "boot_completed=$(getprop sys.boot_completed)"
        echo "locked=$(getprop ro.boot.flash.locked)"
        echo "verified=$(getprop ro.boot.verifiedbootstate)"
        echo "selinux=$(getenforce 2>&1)"
        echo "control_prop=$(getprop ro.pftm10.control)"
        echo "apd=$(/data/adb/apd -V 2>&1)"
        echo "kernel=$(uname -r)"
        ;;
    caps)
        caps_status
        exit $?
        ;;
    health)
        health_status
        exit $?
        ;;
    preload)
        preload_status
        exit $?
        ;;
    kprobe)
        kprobe_status
        exit $?
        ;;
    kprobe-ctl)
        shift
        exec "${0%/*}/pftm10-kpmctl" "$@"
        ;;
    kpm-info)
        kpm_info_status
        rc=$?
        if [ -n "$KPM_INFO" ]; then
            printf '%s\n' "$KPM_INFO"
        fi
        exit "$rc"
        ;;
    kpm-list)
        kpm_list_status
        exit $?
        ;;
    battery-restrict)
        case "$2" in
            status)
                battery_restrict_status
                exit $?
                ;;
            mask|disable)
                battery_restrict_mask
                exit $?
                ;;
            restore|enable)
                battery_restrict_restore
                exit $?
                ;;
            *)
                echo "usage: pftm10ctl battery-restrict {status|mask|restore}" >&2
                exit 2
                ;;
        esac
        ;;
    charge-3a)
        case "$2" in
            status)
                charge_3a_status
                exit $?
                ;;
            enable|arm)
                charge_3a_enable
                exit $?
                ;;
            disable|restore)
                charge_3a_disable
                exit $?
                ;;
            apply)
                charge_3a_apply
                exit $?
                ;;
            *)
                echo "usage: pftm10ctl charge-3a {status|enable|disable|apply}" >&2
                exit 2
                ;;
        esac
        ;;
    root)
        id
        echo "context=$(cat /proc/self/attr/current 2>/dev/null)"
        ;;
    bootlog)
        tail -n 40 "$LOG" 2>/dev/null
        ;;
    kpm)
        dmesg | grep -Ei "pftm10-kprobe|kpm hello" | tail -n 30
        ;;
    enforcing)
        setenforce 1
        getenforce
        ;;
    permissive)
        setenforce 0
        getenforce
        ;;
    *)
        usage
        exit 2
        ;;
esac
